<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="{{ site.author }}" />
    <meta name="keywords" content="{{ keywords or site.keywords }}" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#080b10" />
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}?v=2" />
    <link rel="shortcut icon" href="{{ '/assets/favicon.svg' | url }}?v=2" />
    <link rel="apple-touch-icon" href="{{ '/assets/favicon.svg' | url }}?v=2" />
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="{% if page.url and page.url.startsWith('/posts/') %}article{% else %}website{% endif %}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:image" content="{{ site.image | absoluteUrl(site.url) }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.title }} 技术博客封面" />
    {% if page.url and page.url.startsWith('/posts/') %}
      <meta property="article:author" content="{{ site.author }}" />
      <meta property="article:published_time" content="{{ date | isoDate }}" />
      {% if tags %}
        {% for tag in tags %}
          <meta property="article:tag" content="{{ tag }}" />
        {% endfor %}
      {% endif %}
    {% endif %}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title or site.title }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <meta name="twitter:image" content="{{ site.image | absoluteUrl(site.url) }}" />
    <meta name="twitter:image:alt" content="{{ site.title }} 技术博客封面" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS" href="{{ '/rss.xml' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />
    {% if page.url and page.url.startsWith('/posts/') %}
      <script type="application/ld+json">
        {{ {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": title,
          "description": description,
          "url": page.url | absoluteUrl(site.url),
          "datePublished": date | isoDate,
          "dateModified": date | isoDate,
          "author": {
            "@type": "Person",
            "name": site.author
          },
          "publisher": {
            "@type": "Person",
            "name": site.author
          },
          "image": site.image | absoluteUrl(site.url),
          "mainEntityOfPage": page.url | absoluteUrl(site.url)
        } | jsonify | safe }}
      </script>
    {% else %}
      <script type="application/ld+json">
        {{ {
          "@context": "https://schema.org",
          "@type": "Blog",
          "name": site.title,
          "description": site.description,
          "url": site.url,
          "inLanguage": "zh-CN",
          "author": {
            "@type": "Person",
            "name": site.author
          }
        } | jsonify | safe }}
      </script>
    {% endif %}
  </head>
  <body>
    <div class="ambient-layer" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.title }} 首页">
          <img src="{{ '/assets/favicon.svg' | url }}" alt="" aria-hidden="true" />
          <span class="brand-text">
            <span class="brand-main">CodeMint</span>
            <span class="brand-by">by Sigmund Ming</span>
          </span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a class="nav-text-link" href="{{ '/' | url }}#latest">
            <span class="nav-label">文章</span>
            <span class="nav-mobile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 5.5h16a1.5 1.5 0 0 1 0 3H4a1.5 1.5 0 0 1 0-3Zm0 5h16a1.5 1.5 0 0 1 0 3H4a1.5 1.5 0 0 1 0-3Zm0 5h10.5a1.5 1.5 0 0 1 0 3H4a1.5 1.5 0 0 1 0-3Z" /></svg>
            </span>
          </a>
          <a class="nav-text-link" href="{{ '/bookmarks/' | url }}">
            <span class="nav-label">收藏夹</span>
            <span class="nav-mobile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6.75 3A2.75 2.75 0 0 0 4 5.75v14.5A1.5 1.5 0 0 0 5.5 22h12a.75.75 0 0 0 .75-.75V6.5L12 3 5.75 6.5V4.5a1.25 1.25 0 0 1 2.5 0v9.19l1.5-.85V4.25h2.5V13l1.5-.85V4.25h2.5V12.4l1.5-.85V4.25h2.5v12.5H16a.75.75 0 0 0-.75.75V21H5.5A1 1 0 0 1 4.5 20V5.75A1.25 1.25 0 0 1 5.75 4.5H6a.75.75 0 0 0 0 1.5H5.75" /></svg>
            </span>
          </a>
          <a class="nav-text-link" href="{{ '/rss.xml' | url }}">
            <span class="nav-label">RSS</span>
            <span class="nav-mobile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4.5 5.5A1.5 1.5 0 0 0 3 7v.5A8.5 8.5 0 0 1 11.5 16H12a1.5 1.5 0 0 0 0-3 5 5 0 0 1-5-5V7.5A1.5 1.5 0 0 0 4.5 5.5Zm0 6a1.5 1.5 0 0 0-1.5 1.5V13A5.5 5.5 0 0 1 8 18.5h.5a1.5 1.5 0 0 0 0-3H8a2.5 2.5 0 0 1-2.5-2.5V13A1.5 1.5 0 0 0 4.5 11.5Zm1.75 8A1.75 1.75 0 1 0 8 21.25 1.75 1.75 0 0 0 6.25 19.5Z" /></svg>
            </span>
          </a>
          <a class="nav-text-link" href="{{ '/about/' | url }}">
            <span class="nav-label">关于</span>
            <span class="nav-mobile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 4.5A7.5 7.5 0 1 0 19.5 12 7.5 7.5 0 0 0 12 4.5Zm-1.5 7.75V9.25a1.5 1.5 0 1 1 3 0v2.25a1.5 1.5 0 0 1-1.5 1.5h-1.75v1.5h3a1.5 1.5 0 1 1 0 3h-.75v.75a1.5 1.5 0 0 1-3 0V16h-.75a4.25 4.25 0 0 1 0-8.5H12a1.5 1.5 0 1 1 0 3h-1.5v-1.75Z" /></svg>
            </span>
          </a>
          <a class="nav-icon-link" href="https://github.com/SimonMing47" target="_blank" rel="noreferrer noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18A10.94 10.94 0 0 1 12 6c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
          </a>
          <a class="nav-icon-link" href="mailto:mingxing.tc@gmail.com" aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.75 5.75h14.5c.97 0 1.75.78 1.75 1.75v9c0 .97-.78 1.75-1.75 1.75H4.75A1.75 1.75 0 0 1 3 16.5v-9c0-.97.78-1.75 1.75-1.75Zm.04 1.5 7.21 5.06 7.21-5.06H4.79Zm14.71 1.63-7.07 4.96a.75.75 0 0 1-.86 0L4.5 8.88v7.62c0 .14.11.25.25.25h14.5c.14 0 .25-.11.25-.25V8.88Z" />
            </svg>
          </a>
          <button class="icon-button" id="theme-toggle" type="button" aria-label="切换主题" title="切换主题">◐</button>
        </nav>
      </div>
    </header>
    {{ content | safe }}
    <footer class="container footer">
      <p>{{ site.title }} · 编程学习与工程实践 · {{ "" | year }}</p>
    </footer>
    <script src="{{ '/assets/js/main.js' | url }}"></script>
  </body>
</html>
